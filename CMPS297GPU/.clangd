CompileFlags:
  Remove: 
    - -forward-unknown-to-host-compiler
    - --options-file*
    - --generate-code*
    - -arch*
    - -gencode*
    - -ccbin*
  Add:
    - "-isystem"
    - "/usr/include/c++/15"
    - "-isystem"
    - "/usr/include/x86_64-linux-gnu/c++/15"
    - "-isystem"
    - "/usr/include/c++/15/backward"
    - "-isystem"
    - "/usr/include/x86_64-linux-gnu"
    - "-isystem"
    - "/usr/include"
    - "-isystem"
    - "/usr/local/cuda-13.1/targets/x86_64-linux/include"
    - "-isystem"
    - "/usr/local/cuda-13.1/targets/x86_64-linux/include/cccl"
    - "--cuda-path=/usr/local/cuda-13.1"
    - "--cuda-host-only"
    - "-D__CUDACC__"
    - "-D__CUDACC_VER_MAJOR__=13"
    - "-D__CUDACC_VER_MINOR__=1"
    - "-Wno-unknown-cuda-version"
    - "-Wno-unknown-attributes"
    - "-x"
    - "cuda"
    - "-std=c++17"

Diagnostics:
  Suppress: 
    - deduction_guide_target_attr
    - unknown_cuda_version
