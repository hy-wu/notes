units lj
atom_style atomic
dimension 3
boundary p p p

region sim_box block 0.0 12.0 0.0 12.0 0.0 12.0
create_box 1 sim_box
create_atoms 1 random 1244 12345 sim_box

mass 1 1.0
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
pair_modify tail yes
neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes

minimize 1.0e-4 1.0e-6 100 1000
reset_timestep 0
velocity all create 1.0 87287 dist gaussian mom yes rot yes
fix nvt_run all nvt temp 1.0 1.0 0.1
run 5000

reset_timestep 0
variable v_step equal step
variable v_temp equal temp
variable v_press equal press
variable v_pe equal pe
variable v_etotal equal etotal
fix csv_out all print 10 "${v_step},${v_temp},${v_press},${v_pe},${v_etotal}" file argon_results\compressibility_scan\lammps_rho_1244_timeseries.csv screen no title "Step,T,P,PE,TotalE"

run 5000
